# Copia a `.env` y reinicia Metro (`npm start` con caché limpia si cambias URLs).
#
# --- Local (Goi Server en tu PC) ---
# EXPO_PUBLIC_API_URL=http://127.0.0.1:4000/api
# En móvil físico en la misma Wi‑Fi, deja vacío: npm start detecta la IP del PC.
#
# --- Producción (Render) ---
# EXPO_PUBLIC_API_URL=https://goi-server.onrender.com/api
#
# EXPO_PUBLIC_AUTH_API_URL=   ← déjalo vacío

EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_AUTH_API_URL=
