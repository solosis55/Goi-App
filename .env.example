# Goi App — dos backends durante la migración (Fase 7):
# - Goi Server (Next.js + Neon): posts, feed, comentarios → puerto 4000
# - Goi Web server (Express): auth, entrenos, social → puerto 4001
#
# Copia a `.env` y reinicia Metro (`npx expo start`).
#
# Posts / feed (Goi Server):
# EXPO_PUBLIC_API_URL=http://192.168.1.10:4000/api
#
# Login, perfil, rutinas (Goi Web server — arranca con PORT=4001):
# EXPO_PUBLIC_AUTH_API_URL=http://192.168.1.10:4001/api

EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_AUTH_API_URL=
