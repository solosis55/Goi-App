# Copia a `.env` y reinicia Metro (`npm start` con caché limpia si cambias URLs).
#
# Goi Server (Next.js + Neon) — puerto 4000. Toda la API va aquí.
# En móvil físico, deja vacío: npm start detecta la IP del PC automáticamente.
#
# EXPO_PUBLIC_API_URL=http://192.168.1.29:4000/api
#
# No uses :4001 salvo que mantengas Express legacy a propósito.
# EXPO_PUBLIC_AUTH_API_URL=   ← déjalo vacío o igual que API_URL

EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_AUTH_API_URL=
